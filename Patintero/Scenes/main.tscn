[sub_resource type="GDScript" id="GDScript_8gbba"]
script/source = "extends Node

signal lane_advanced(lane_index: int)

@export var player: Node2D
# X position of each vertical line, left to right. Adjust to match your court.
@export var lane_xs: Array[float] = [247.0, 512.0, 778.0, 1046.0]

var current_lane: int = -1

func _process(_delta: float) -> void:
	if player == null:
		return
	var lane := _get_lane(player.global_position.x)
	# Only fire when the player moves forward to a new line
	if lane > current_lane:
		current_lane = lane
		lane_advanced.emit(lane)

func _get_lane(x: float) -> int:
	var lane := -1
	for i in lane_xs.size():
		if x >= lane_xs[i]:
			lane = i
	return lane
"

